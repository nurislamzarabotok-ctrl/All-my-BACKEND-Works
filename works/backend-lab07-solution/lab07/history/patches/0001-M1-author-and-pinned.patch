diff --git a/app/routers/messages.py b/app/routers/messages.py
index 4c2356f..a1329d6 100644
--- a/app/routers/messages.py
+++ b/app/routers/messages.py
@@ -8,11 +8,12 @@ router = APIRouter(prefix="/messages", tags=["messages"])
 
 
 @router.get("", response_model=list[Message])
-def list_messages(store: StorageDep) -> list[Message]:
-    # TODO M1 to M4: one query parameter at a time, see README.md.
-    # Each new parameter goes into the list above, next to store,
-    # and into the call below, as author=author.
-    return store.find()
+def list_messages(
+    store: StorageDep,
+    author: str | None = None,
+    pinned: bool | None = None,
+) -> list[Message]:
+    return store.find(author=author, pinned=pinned)
 
 
 @router.post("", response_model=Message, status_code=201)
diff --git a/app/storage.py b/app/storage.py
index 97f2948..b6e74cf 100644
--- a/app/storage.py
+++ b/app/storage.py
@@ -2,7 +2,7 @@ from app.errors import ChatFull, MessageNotFound
 from app.models import Message
 from app.schemas import MessageIn
 
-MAX_MESSAGES = 3
+MAX_MESSAGES = 100
 
 
 class Storage:
@@ -22,12 +22,11 @@ class Storage:
         limit: int = 10,
         offset: int = 0,
     ) -> list[Message]:
-        # The route passes what the client sent. This method does the work.
-        # TODO M1: keep only the messages of this author, and with this pinned
-        # TODO M2: keep only the messages whose text contains q, in any case
-        # TODO M3: sort by id: old first, or new first when order is "desc"
-        # TODO M4: cut out one page: skip offset messages, then take limit of them
         result = self.messages
+        if author is not None:
+            result = [m for m in result if m.author == author]
+        if pinned is not None:
+            result = [m for m in result if m.pinned == pinned]
         return result
 
     def get(self, message_id: int) -> Message:
