Subject: [PATCH 3/6] M3: ascending and descending order

---
 app/routers/messages.py    |    5 +-
 app/storage.py             |    1 +
 checks/m3-bruno-server.log |   34 +
 checks/m3-bruno.json       | 2136 ++++++++++++++++++++++++++++++++++++
 checks/m3-bruno.txt        |  139 +++
 5 files changed, 2313 insertions(+), 2 deletions(-)
 create mode 100644 checks/m3-bruno-server.log
 create mode 100644 checks/m3-bruno.json
 create mode 100644 checks/m3-bruno.txt

diff --git a/app/routers/messages.py b/app/routers/messages.py
index 97bf2a7..cf40d9d 100644
--- a/app/routers/messages.py
+++ b/app/routers/messages.py
@@ -1,4 +1,4 @@
-from typing import Annotated
+from typing import Annotated, Literal
 
 from fastapi import APIRouter, Query
 
@@ -15,8 +15,9 @@ def list_messages(
     author: str | None = None,
     pinned: bool | None = None,
     q: Annotated[str | None, Query(min_length=2, max_length=50)] = None,
+    order: Literal["asc", "desc"] = "asc",
 ) -> list[Message]:
-    return store.find(author=author, pinned=pinned, q=q)
+    return store.find(author=author, pinned=pinned, q=q, order=order)
 
 
 @router.post("", response_model=Message, status_code=201)
diff --git a/app/storage.py b/app/storage.py
index 9b1e576..b101d74 100644
--- a/app/storage.py
+++ b/app/storage.py
@@ -29,6 +29,7 @@ class Storage:
             result = [m for m in result if m.pinned == pinned]
         if q is not None:
             result = [m for m in result if q.lower() in m.text.lower()]
+        result = sorted(result, key=lambda m: m.id, reverse=order == "desc")
         return result
 
     def get(self, message_id: int) -> Message:
