From: Notion AI <notion-ai@localhost>
Date: Tue, 27 Oct 2026 09:20:47 +0000
Subject: [PATCH 2/6] M2: case-insensitive text search

---
 app/routers/messages.py    |    7 +-
 app/storage.py             |    2 +
 checks/m2-bruno-server.log |   34 +
 checks/m2-bruno.json       | 2163 ++++++++++++++++++++++++++++++++++++
 checks/m2-bruno.txt        |  144 +++
 5 files changed, 2348 insertions(+), 2 deletions(-)
 create mode 100644 checks/m2-bruno-server.log
 create mode 100644 checks/m2-bruno.json
 create mode 100644 checks/m2-bruno.txt

diff --git a/app/routers/messages.py b/app/routers/messages.py
index a1329d6..97bf2a7 100644
--- a/app/routers/messages.py
+++ b/app/routers/messages.py
@@ -1,4 +1,6 @@
-from fastapi import APIRouter
+from typing import Annotated
+
+from fastapi import APIRouter, Query
 
 from app.deps import StorageDep
 from app.models import Message
@@ -12,8 +14,9 @@ def list_messages(
     store: StorageDep,
     author: str | None = None,
     pinned: bool | None = None,
+    q: Annotated[str | None, Query(min_length=2, max_length=50)] = None,
 ) -> list[Message]:
-    return store.find(author=author, pinned=pinned)
+    return store.find(author=author, pinned=pinned, q=q)
 
 
 @router.post("", response_model=Message, status_code=201)
diff --git a/app/storage.py b/app/storage.py
index b6e74cf..9b1e576 100644
--- a/app/storage.py
+++ b/app/storage.py
@@ -27,6 +27,8 @@ class Storage:
             result = [m for m in result if m.author == author]
         if pinned is not None:
             result = [m for m in result if m.pinned == pinned]
+        if q is not None:
+            result = [m for m in result if q.lower() in m.text.lower()]
         return result
 
     def get(self, message_id: int) -> Message:
