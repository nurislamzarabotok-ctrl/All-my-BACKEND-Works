Date: Tue, 27 Oct 2026 09:20:53 +0000
Subject: [PATCH 4/6] M4: limit and offset pagination

---
 app/routers/messages.py           |    4 +-
 app/storage.py                    |    2 +-
 checks/m4-bruno-repeat-server.log |   34 +
 checks/m4-bruno-repeat.json       | 1985 +++++++++++++++++++++++++++++
 checks/m4-bruno-repeat.txt        |  127 ++
 checks/m4-bruno-server.log        |   34 +
 checks/m4-bruno.json              | 1985 +++++++++++++++++++++++++++++
 checks/m4-bruno.txt               |  127 ++
 8 files changed, 4296 insertions(+), 2 deletions(-)
 create mode 100644 checks/m4-bruno-repeat-server.log
 create mode 100644 checks/m4-bruno-repeat.json
 create mode 100644 checks/m4-bruno-repeat.txt
 create mode 100644 checks/m4-bruno-server.log
 create mode 100644 checks/m4-bruno.json
 create mode 100644 checks/m4-bruno.txt

diff --git a/app/routers/messages.py b/app/routers/messages.py
index cf40d9d..b65ccf5 100644
--- a/app/routers/messages.py
+++ b/app/routers/messages.py
@@ -16,8 +16,10 @@ def list_messages(
     pinned: bool | None = None,
     q: Annotated[str | None, Query(min_length=2, max_length=50)] = None,
     order: Literal["asc", "desc"] = "asc",
+    limit: Annotated[int, Query(ge=1, le=50)] = 10,
+    offset: Annotated[int, Query(ge=0)] = 0,
 ) -> list[Message]:
-    return store.find(author=author, pinned=pinned, q=q, order=order)
+    return store.find(author=author, pinned=pinned, q=q, order=order, limit=limit, offset=offset)
 
 
 @router.post("", response_model=Message, status_code=201)
diff --git a/app/storage.py b/app/storage.py
index b101d74..2b39051 100644
--- a/app/storage.py
+++ b/app/storage.py
@@ -30,7 +30,7 @@ class Storage:
         if q is not None:
             result = [m for m in result if q.lower() in m.text.lower()]
         result = sorted(result, key=lambda m: m.id, reverse=order == "desc")
-        return result
+        return result[offset:offset + limit]
 
     def get(self, message_id: int) -> Message:
         for message in self.messages:
