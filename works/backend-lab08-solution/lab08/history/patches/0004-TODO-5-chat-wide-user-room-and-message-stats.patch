diff --git a/app/routers/stats.py b/app/routers/stats.py
index 4c38aee..ce0b8b4 100644
--- a/app/routers/stats.py
+++ b/app/routers/stats.py
@@ -9,5 +9,9 @@ router = APIRouter(prefix="/stats", tags=["stats"])
 def get_stats(store: StorageDep) -> dict:
     messages = store.get_all()
     pinned = sum(m.pinned for m in messages)
-    # TODO 5: count the users and the rooms too, see README.md
-    return {"messages": len(messages), "pinned": pinned}
+    return {
+        "users": len(store.get_users()),
+        "rooms": len(store.get_rooms()),
+        "messages": len(messages),
+        "pinned": pinned,
+    }
