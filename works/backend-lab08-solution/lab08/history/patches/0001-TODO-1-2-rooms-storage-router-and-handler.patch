-    # TODO 1: get_rooms, get_room and add_room, the same way as the three user methods.
-    # get_room raises RoomNotFound. add_room uses self.next_room_id.
+    def get_rooms(self) -> list[Room]:
+        return self.rooms
+
+    def get_room(self, room_id: int) -> Room:
+        for room in self.rooms:
+            if room.id == room_id:
+                return room
+        raise RoomNotFound(room_id)
+
+    def add_room(self, data: RoomIn) -> Room:
+        room = Room(id=self.next_room_id, title=data.title)
+        self.rooms.append(room)
+        self.next_room_id += 1
+        return room
 
